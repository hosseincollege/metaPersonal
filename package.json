{
  "name": "metavers-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "api": "node server/index.js",
    "start": "node server/index.js",
    "start:api-server": "set \"API_PORT=5274\" && node server/index.js",
    "db:migrate": "node database/migrate.js",
    "build": "vite build",
    "build:server": "set \"VITE_BASE_PATH=/meta-personal/\" && set \"VITE_API_BASE=/meta-personal/api\" && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:server": "vite preview --host 127.0.0.1 --port 5273 --strictPort"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.28.0",
    "pg": "^8.23.1",
    "postprocessing": "^6.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.2",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
